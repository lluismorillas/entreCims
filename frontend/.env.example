# Copia aquest fitxer a .env per canviar els valors per defecte.
# Vite llegeix aquests valors en compilar: si en canvies algun, torna a compilar.

# Rajoles del mapa base. Per defecte, les d'OpenStreetMap.
# VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Terreny 3D: URL d'una TileJSON raster-dem. Per defecte, la de Mapterhorn.
# Deixa-la buida per tenir un mapa 2D sense cap petició d'elevació.
# VITE_TERRAIN_TILEJSON_URL=https://tiles.mapterhorn.com/tilejson.json
