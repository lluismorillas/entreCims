# ─────────────────────────────────────────────
# Dades personals (principi III de la constitució)
# ─────────────────────────────────────────────
# Dades de l'aplicació: SQLite, originals i fotos
data/
# Tracks reals per a l'avaluació
eval/private/

/sample-data

# Xarxa de seguretat: cap track real fora de sample-data/
*.gpx
*.fit
*.tcx
!sample-data/**/*.gpx
!sample-data/**/*.fit
!sample-data/**/*.tcx
# Fixtures sintètiques de les proves
!backend/tests/**/*.gpx
!backend/tests/**/*.fit
!backend/tests/**/*.tcx

# Bases de dades locals fora de data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ─────────────────────────────────────────────
# Documents SDD (de treball local, segons plan.md)
# ─────────────────────────────────────────────
.specify/
specs/

